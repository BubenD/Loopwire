/* Edraw — AutoCAD-style charcoal-gray chrome (canvas stays dark via its own paint). */
QMainWindow, QWidget {
    background-color: #3a3d43;
    color: #c9ccd1;
    font-size: 12px;
}
QStatusBar {
    background-color: #2d2f34;
    color: #aab0b8;
    border-top: 1px solid #2a2c31;
}
/* Dark-gray menu bar + menus (AutoCAD-style chrome). */
QMenuBar { background-color: #2d2f34; color: #c9ccd1; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #3d4148; color: #fff; }
QMenu { background-color: #33363c; color: #c9ccd1; border: 1px solid #4a4e55; }
QMenu::item { padding: 4px 22px; }
QMenu::item:selected { background-color: #294e74; color: #fff; }
QMenu::separator { height: 1px; background: #4a4e55; margin: 3px 6px; }

/* ---- Document tab bar (Drawing1 / ...) ---- */
QTabWidget::pane {
    background-color: #3a3d43;
    border: none;
    border-bottom: 1px solid #2a2c31;
}
QTabBar { background: #2f3237; }
QTabBar::tab {
    background: transparent;
    color: #aab0b8;
    padding: 5px 14px;
    margin: 0;
    border: none;
}
QTabBar::tab:hover { color: #ffffff; }
QTabBar::tab:selected {
    color: #ffffff;
    border-bottom: 2px solid #3d8bfd;
}

/* ---- Tool buttons ---- */
QToolButton {
    background: transparent;
    color: #c9ccd1;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 6px;
}
QToolButton:hover { background: #484c53; border-color: #5a5f68; }
QToolButton:checked { background: #294e74; border-color: #3d8bfd; }
QToolButton:pressed { background: #22384f; }

/* ---- Toolbars (incl. bottom command bar) ---- */
QToolBar { background-color: #2d2f34; border: none; spacing: 2px; }
QToolBar::separator { background: #4a4e55; width: 1px; margin: 4px 4px; }

/* ---- Dock panels ---- */
QDockWidget {
    color: #aab0b8;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #34373d;
    padding: 5px 8px;
    border-bottom: 1px solid #2a2c31;
    font-weight: bold;
    color: #aab0b8;
}

/* ---- Tables ---- */
QTableWidget, QListWidget {
    background-color: #3a3d43;
    alternate-background-color: #41454c;
    color: #c9ccd1;
    gridline-color: #4a4e55;
    selection-background-color: #294e74;
    selection-color: #ffffff;
    border: 1px solid #2a2c31;
}
QHeaderView::section {
    background-color: #313438;
    color: #aab0b8;
    padding: 3px 6px;
    border: none;
    border-right: 1px solid #2a2c31;
    border-bottom: 1px solid #2a2c31;
}
QListWidget::item:selected { background: #294e74; }

/* ---- Inputs ---- */
QComboBox, QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #45484f;
    color: #e0e2e6;
    border: 1px solid #585c64;
    border-radius: 3px;
    padding: 2px 4px;
}
QComboBox:hover, QLineEdit:focus { border-color: #3d8bfd; }
/* Combos get a distinct, button-like drop-down box with a clear down-chevron,
   matching the "Copy" split-button's fall-menu affordance across the app. */
QComboBox::drop-down {
    subcontrol-origin: padding; subcontrol-position: right center;
    background-color: #565b64; border-left: 1px solid #585c64;
    border-top-right-radius: 3px; border-bottom-right-radius: 3px; width: 18px;
}
QComboBox::drop-down:hover { background-color: #6a6f78; }
QComboBox::down-arrow { image: url(:/caret-down.svg); width: 12px; height: 12px; }
/* +/- spin buttons: clearly separated so each is independently clickable. */
QAbstractSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 18px; border-left: 1px solid #585c64; }
QAbstractSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 18px; border-left: 1px solid #585c64; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background: #3d8bfd; }
QComboBox QAbstractItemView {
    background: #3a3d43;
    color: #e0e2e6;
    selection-background-color: #294e74;
}
QPushButton {
    background-color: #484c53;
    color: #d7dade;
    border: 1px solid #5a5f68;
    border-radius: 3px;
    padding: 3px 10px;
}
QPushButton:hover { background-color: #525760; }
QPushButton:pressed { background-color: #3a3e45; }

/* ---- Scrollbars ---- */
QScrollBar:vertical { background: #2d2f34; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #5a5f68; border-radius: 5px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #2d2f34; height: 10px; }
QScrollBar::handle:horizontal { background: #5a5f68; border-radius: 5px; min-width: 20px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
